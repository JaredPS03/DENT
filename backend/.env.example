# Copia este archivo como backend/.env y pon tus valores. Nunca subas .env al repositorio.
# Los secretos de staging y producción van en los secretos del hosting, no en archivos.

# development | staging | production. Fuera de production solo se envía a WHATSAPP_ALLOWED_TEST_NUMBERS.
ENVIRONMENT=development

# Postgres como el rol axon_app (nunca postgres ni la service role).
# Local: la base de `pnpm db:start`; la contraseña local la fija supabase/seed.sql y no sirve en ningún otro lado.
# Nube: pooler de Supabase en modo sesión, usuario axon_app.<project-ref>, contraseña que pones tú con
#   alter role axon_app with password '...';
#   postgresql://axon_app.<project-ref>:<contraseña>@<pooler-host>:5432/postgres?sslmode=require
#   Si la contraseña lleva símbolos (% / @ : ? # y otros), van codificados: % es %25, / es %2F, @ es %40.
DATABASE_URL=postgresql://axon_app:axon_app_local@127.0.0.1:54322/postgres
DB_POOL_MAX_SIZE=10

# Supabase: URL del proyecto, para verificar las sesiones del panel con sus llaves públicas.
# Local: la que imprime `pnpm db:start`. Nube: https://<project-ref>.supabase.co
SUPABASE_URL=http://127.0.0.1:54321

# Meta: developers.facebook.com > tu app > Configuración > Básica > Clave secreta de la app.
WHATSAPP_APP_SECRET=
# Lo inventas tú (cadena larga y aleatoria) y lo pegas igual al configurar el webhook en Meta.
WHATSAPP_VERIFY_TOKEN=
# Token de un usuario del sistema de tu Business Manager con permisos de WhatsApp.
WHATSAPP_ACCESS_TOKEN=
# Versión vigente de la Graph API que muestra tu app en Meta, por ejemplo v24.0.
META_GRAPH_VERSION=

# Números que pueden recibir mensajes fuera de producción, en E.164 y separados por comas.
WHATSAPP_ALLOWED_TEST_NUMBERS=
# Id del número de prueba de Meta (WhatsApp > Configuración de la API > Identificador del número).
WHATSAPP_TEST_PHONE_NUMBER_ID=

# Bot de eco del hito 1B: contesta "Prueba de Axon… Recibí: …" para probar la ida y vuelta con el número de prueba.
# Solo en desarrollo o staging; en producción el backend no arranca con esto encendido.
ECHO_BOT_ENABLED=false

# Notas de voz a texto con OpenAI (gpt-transcribe), que no entrena con los audios ni los guarda.
# Llave de platform.openai.com > API keys, de un proyecto con el DPA firmado. Sin llave, los audios
# se guardan pero no se transcriben.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe

# Storage de Supabase por su protocolo S3, para el bucket privado de audios y fotos. Estas llaves solo
# abren Storage, no la base.
# Local: `pnpm supabase status` imprime STORAGE_S3_URL, S3_PROTOCOL_ACCESS_KEY_ID,
#   S3_PROTOCOL_ACCESS_KEY_SECRET y S3_PROTOCOL_REGION.
# Nube: Dashboard > Storage > S3 Configuration (endpoint, región y una llave de acceso nueva).
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=local
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# Trabajos que atiende a la vez cada worker.
WORKER_CONCURRENCY=4

# Opcional. Sin valor, Sentry queda apagado.
SENTRY_DSN=
LOG_LEVEL=INFO
